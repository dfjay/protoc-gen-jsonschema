{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/.tests.Values",
  "$defs": {
    ".tests.Values": {
      "properties": {
        "int64Map": {
          "$ref": "#/$defs/.tests.Values.int64_map"
        },
        "uint64Map": {
          "$ref": "#/$defs/.tests.Values.uint64_map"
        },
        "int32Map": {
          "$ref": "#/$defs/.tests.Values.int32_map"
        }
      },
      "type": "object"
    },
    ".tests.Values.int32_map": {
      "additionalProperties": {
        "type": "integer"
      },
      "type": "object"
    },
    ".tests.Values.int64_map": {
      "additionalProperties": {
        "type": "string",
        "pattern": "^-?(0|[1-9][0-9]*)$"
      },
      "type": "object"
    },
    ".tests.Values.uint64_map": {
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "type": "object"
    }
  }
}