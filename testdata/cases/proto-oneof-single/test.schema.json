{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/.samples.Values",
  "$defs": {
    ".samples.Values": {
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "stringValue"
              ]
            },
            {
              "required": [
                "intValue"
              ]
            },
            {
              "required": [
                "boolValue"
              ]
            },
            {
              "required": [
                "doubleValue"
              ]
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "stringValue"
                    ]
                  },
                  {
                    "required": [
                      "intValue"
                    ]
                  },
                  {
                    "required": [
                      "boolValue"
                    ]
                  },
                  {
                    "required": [
                      "doubleValue"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/.samples.Values.value"
        },
        "count": {
          "$ref": "#/$defs/.samples.Values.count"
        },
        "stringValue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.samples.Values.string_value"
            }
          ]
        },
        "intValue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.samples.Values.int_value"
            }
          ]
        },
        "boolValue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.samples.Values.bool_value"
            }
          ]
        },
        "doubleValue": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.samples.Values.double_value"
            }
          ]
        }
      },
      "type": "object"
    },
    ".samples.Values.bool_value": {
      "type": "boolean"
    },
    ".samples.Values.count": {
      "type": "integer"
    },
    ".samples.Values.double_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "NaN",
            "Infinity",
            "-Infinity"
          ]
        }
      ]
    },
    ".samples.Values.int_value": {
      "type": "integer"
    },
    ".samples.Values.string_value": {
      "type": "string"
    },
    ".samples.Values.value": {
      "type": "string"
    }
  }
}