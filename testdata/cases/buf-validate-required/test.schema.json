{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/.tests.Values",
  "$defs": {
    ".tests.Level": {
      "type": "string",
      "enum": [
        "LEVEL_UNSPECIFIED",
        "LEVEL_LOW"
      ]
    },
    ".tests.Nested": {
      "properties": {
        "value": {
          "$ref": "#/$defs/.tests.Nested.value"
        }
      },
      "type": "object"
    },
    ".tests.Nested.value": {
      "type": "string"
    },
    ".tests.Values": {
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "a"
              ]
            },
            {
              "required": [
                "b"
              ]
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "a"
                    ]
                  },
                  {
                    "required": [
                      "b"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/.tests.Values.name"
        },
        "nested": {
          "$ref": "#/$defs/.tests.Values.nested"
        },
        "ignored": {
          "$ref": "#/$defs/.tests.Values.ignored"
        },
        "a": {
          "$ref": "#/$defs/.tests.Values.a"
        },
        "b": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.b"
            }
          ]
        },
        "positive": {
          "$ref": "#/$defs/.tests.Values.positive"
        },
        "level": {
          "$ref": "#/$defs/.tests.Values.level"
        },
        "tags": {
          "$ref": "#/$defs/.tests.Values.tags"
        },
        "labels": {
          "$ref": "#/$defs/.tests.Values.labels"
        },
        "code": {
          "$ref": "#/$defs/.tests.Values.code"
        },
        "anyCount": {
          "$ref": "#/$defs/.tests.Values.any_count"
        },
        "skippable": {
          "$ref": "#/$defs/.tests.Values.skippable"
        },
        "maybe": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.maybe"
            }
          ]
        }
      },
      "type": "object",
      "required": [
        "name",
        "nested",
        "a",
        "positive",
        "level",
        "tags",
        "labels",
        "code"
      ]
    },
    ".tests.Values.a": {
      "type": "string",
      "description": "A required member must be the one set."
    },
    ".tests.Values.any_count": {
      "type": "integer",
      "minimum": 0,
      "description": "These accept their zero value, or skip the rules for it."
    },
    ".tests.Values.b": {
      "type": "string"
    },
    ".tests.Values.code": {
      "type": "string",
      "pattern": "^(?:[A-Z])+$"
    },
    ".tests.Values.ignored": {
      "type": "string"
    },
    ".tests.Values.labels": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object",
      "minProperties": 1
    },
    ".tests.Values.level": {
      "$ref": "#/$defs/.tests.Level",
      "allOf": [
        {
          "not": {
            "enum": [
              "LEVEL_UNSPECIFIED"
            ]
          }
        }
      ]
    },
    ".tests.Values.maybe": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "A field with presence may be absent."
    },
    ".tests.Values.name": {
      "allOf": [
        {
          "not": {
            "const": ""
          }
        }
      ],
      "type": "string"
    },
    ".tests.Values.nested": {
      "$ref": "#/$defs/.tests.Nested"
    },
    ".tests.Values.positive": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "An absent field without presence is zero, which these rules reject."
    },
    ".tests.Values.skippable": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "minLength": 2
        }
      ]
    },
    ".tests.Values.tags": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "minItems": 1
    }
  }
}