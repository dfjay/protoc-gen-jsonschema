{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/.tests.Values",
  "$defs": {
    ".tests.Values": {
      "properties": {
        "range": {
          "$ref": "#/$defs/.tests.Values.range"
        },
        "outside": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.outside"
            }
          ]
        },
        "oneOf": {
          "$ref": "#/$defs/.tests.Values.one_of"
        },
        "notOneOf": {
          "$ref": "#/$defs/.tests.Values.not_one_of"
        },
        "constant": {
          "$ref": "#/$defs/.tests.Values.constant"
        },
        "big": {
          "$ref": "#/$defs/.tests.Values.big"
        },
        "finite": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.finite"
            }
          ]
        },
        "positive": {
          "$ref": "#/$defs/.tests.Values.positive"
        },
        "notZero": {
          "$ref": "#/$defs/.tests.Values.not_zero"
        },
        "mustBeTrue": {
          "$ref": "#/$defs/.tests.Values.must_be_true"
        },
        "code": {
          "$ref": "#/$defs/.tests.Values.code"
        },
        "name": {
          "$ref": "#/$defs/.tests.Values.name"
        },
        "slug": {
          "$ref": "#/$defs/.tests.Values.slug"
        },
        "safe": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.safe"
            }
          ]
        },
        "color": {
          "$ref": "#/$defs/.tests.Values.color"
        },
        "email": {
          "$ref": "#/$defs/.tests.Values.email"
        },
        "id": {
          "$ref": "#/$defs/.tests.Values.id"
        },
        "ip": {
          "$ref": "#/$defs/.tests.Values.ip"
        },
        "link": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.link"
            }
          ]
        },
        "ignored": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.ignored"
            }
          ]
        },
        "optionalEmail": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.optional_email"
            }
          ]
        },
        "presenceEmail": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.presence_email"
            }
          ]
        },
        "letters": {
          "$ref": "#/$defs/.tests.Values.letters"
        },
        "outsideInf": {
          "$ref": "#/$defs/.tests.Values.outside_inf"
        },
        "upToInf": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.up_to_inf"
            }
          ]
        },
        "onlyInf": {
          "$ref": "#/$defs/.tests.Values.only_inf"
        },
        "dot": {
          "$ref": "#/$defs/.tests.Values.dot"
        },
        "folded": {
          "$ref": "#/$defs/.tests.Values.folded"
        },
        "smile": {
          "$ref": "#/$defs/.tests.Values.smile"
        },
        "noNull": {
          "$ref": "#/$defs/.tests.Values.no_null"
        },
        "groups": {
          "$ref": "#/$defs/.tests.Values.groups"
        },
        "exemptNull": {
          "$ref": "#/$defs/.tests.Values.exempt_null"
        },
        "wrappedItems": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.wrapped_items"
            }
          ]
        },
        "wrapped": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.wrapped"
            }
          ]
        },
        "small": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/.tests.Values.small"
            }
          ]
        }
      },
      "type": "object",
      "required": [
        "range",
        "oneOf",
        "notOneOf",
        "constant",
        "big",
        "positive",
        "notZero",
        "mustBeTrue",
        "code",
        "name",
        "slug",
        "color",
        "email",
        "id",
        "ip",
        "letters",
        "outsideInf",
        "onlyInf",
        "dot",
        "folded",
        "smile",
        "noNull",
        "groups"
      ]
    },
    ".tests.Values.big": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "minimum": 1,
      "description": "64-bit integers are strings: bounds apply only through in."
    },
    ".tests.Values.code": {
      "type": "string",
      "maxLength": 3,
      "minLength": 3
    },
    ".tests.Values.color": {
      "type": "string",
      "enum": [
        "red",
        "green"
      ]
    },
    ".tests.Values.constant": {
      "type": "integer",
      "const": 7,
      "maximum": 4294967295,
      "minimum": 0
    },
    ".tests.Values.dot": {
      "type": "string",
      "pattern": "^a[^\\n]c$",
      "description": "\".\" matches \\r in RE2; (?i) and \\x{...} have no ECMA-262 syntax."
    },
    ".tests.Values.email": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.!#$%\u0026'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
    },
    ".tests.Values.exempt_null": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "NULL_VALUE",
                0
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": -2147483648
            },
            {
              "not": {
                "enum": [
                  0
                ]
              }
            }
          ]
        }
      ],
      "description": "null is the zero value, which the rules skip."
    },
    ".tests.Values.finite": {
      "type": "number"
    },
    ".tests.Values.folded": {
      "type": "string",
      "pattern": "^[Aa][Bb]$"
    },
    ".tests.Values.groups": {
      "type": "string",
      "pattern": "^(?:a)(?:b)(?:(?:c))?$",
      "description": "RE2 allows group names ECMA-262 does not."
    },
    ".tests.Values.id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    ".tests.Values.ignored": {
      "type": "string"
    },
    ".tests.Values.ip": {
      "allOf": [
        {
          "anyOf": [
            {
              "pattern": "^(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])){3}$"
            },
            {
              "format": "ipv6"
            },
            {
              "pattern": "^(?:(?:[0-9A-Fa-f]{1,4}:){6}[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|::(?:[0-9A-Fa-f]{1,4}:){5}[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4})?::)%[\\s\\S]+$"
            }
          ]
        }
      ],
      "type": "string"
    },
    ".tests.Values.letters": {
      "type": "string",
      "pattern": "^(?:[A-Za-z])+(?:(?:-[0-9]))?$",
      "description": "RE2 syntax becomes ECMA-262."
    },
    ".tests.Values.link": {
      "type": "string",
      "format": "uri-reference"
    },
    ".tests.Values.must_be_true": {
      "type": "boolean",
      "const": true
    },
    ".tests.Values.name": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    ".tests.Values.no_null": {
      "allOf": [
        {
          "type": "integer",
          "maximum": 2147483647,
          "minimum": -2147483648
        },
        {
          "not": {
            "enum": [
              0
            ]
          }
        }
      ]
    },
    ".tests.Values.not_one_of": {
      "allOf": [
        {
          "not": {
            "enum": [
              0
            ]
          }
        }
      ],
      "type": "integer",
      "maximum": 2147483647,
      "minimum": -2147483648
    },
    ".tests.Values.not_zero": {
      "allOf": [
        {
          "not": {
            "enum": [
              0
            ]
          }
        }
      ],
      "type": "number",
      "description": "not_in alone keeps NaN and the infinities."
    },
    ".tests.Values.one_of": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "maximum": 2147483647,
      "minimum": -2147483648
    },
    ".tests.Values.only_inf": {
      "allOf": [
        {
          "not": {}
        }
      ],
      "type": "number"
    },
    ".tests.Values.optional_email": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.!#$%\u0026'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
        }
      ],
      "description": "The empty string is exempt from the rules."
    },
    ".tests.Values.outside": {
      "allOf": [
        {
          "anyOf": [
            {
              "exclusiveMinimum": 10
            },
            {
              "exclusiveMaximum": 5
            }
          ]
        }
      ],
      "type": "integer",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "description": "A lower bound above the upper one means outside the range."
    },
    ".tests.Values.outside_inf": {
      "allOf": [
        {
          "anyOf": [
            {
              "not": {}
            },
            {
              "exclusiveMaximum": 0
            }
          ]
        }
      ],
      "type": "number",
      "description": "Outside a range with an infinite bound."
    },
    ".tests.Values.positive": {
      "type": "number",
      "exclusiveMinimum": 0.1
    },
    ".tests.Values.presence_email": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9.!#$%\u0026'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$",
      "description": "A field with presence is not exempt when zero."
    },
    ".tests.Values.range": {
      "type": "integer",
      "maximum": 100,
      "exclusiveMinimum": 0
    },
    ".tests.Values.safe": {
      "allOf": [
        {
          "not": {
            "enum": [
              "admin"
            ]
          }
        },
        {
          "not": {
            "pattern": "\\.\\."
          }
        }
      ],
      "type": "string"
    },
    ".tests.Values.slug": {
      "allOf": [
        {
          "pattern": "^a\\."
        },
        {
          "pattern": "z$"
        },
        {
          "pattern": "-"
        }
      ],
      "type": "string",
      "pattern": "^(?:[\\--.a-z])+$"
    },
    ".tests.Values.small": {
      "allOf": [
        {
          "not": {
            "enum": [
              1
            ]
          }
        }
      ],
      "type": "integer",
      "maximum": 4294967295,
      "minimum": 0,
      "description": "Numbers stay within the range of the type."
    },
    ".tests.Values.smile": {
      "type": "string",
      "pattern": "^😀$"
    },
    ".tests.Values.up_to_inf": {
      "type": "number"
    },
    ".tests.Values.wrapped": {
      "type": "integer",
      "maximum": 2147483647,
      "minimum": 1
    },
    ".tests.Values.wrapped_items": {
      "items": {
        "anyOf": [
          {
            "anyOf": [
              {
                "const": 0
              },
              {
                "type": "string",
                "pattern": "^-?0(\\.0+)?([eE][+-]?[0-9]+)?$"
              }
            ]
          },
          {
            "type": "integer",
            "maximum": 2147483647,
            "minimum": 1
          }
        ]
      },
      "type": "array"
    }
  }
}